# =============================================================================
# .env.example — VNSTOCK: danh sách biến môi trường project sử dụng.
#
# LƯU Ý: project KHÔNG tự đọc file .env (không dùng python-dotenv). Đây chỉ là
# tài liệu tham khảo — set biến trực tiếp vào môi trường (PowerShell:
#   $env:ANTHROPIC_API_KEY = "..."   hoặc Windows > Environment Variables).
# KHÔNG ghi giá trị thật vào file này; file .env thật (nếu tạo) đã bị gitignore.
# =============================================================================

# ai_analyzer.py — bắt buộc khi gọi API thật (không cần cho --dry-run).
# SDK anthropic tự đọc biến này từ môi trường.
ANTHROPIC_API_KEY=

# publish_dashboard.py + sync_and_publish.bat — chỉ cần khi tách thư mục
# backend (nơi sinh dữ liệu) và thư mục web (repo GitHub Pages).
# Mặc định cả hai = thư mục chứa script, không cần set.
STOCK_LOOKUP_BACKEND_DIR=
STOCK_LOOKUP_WEB_DIR=

# sync_and_publish.bat — đường dẫn python dùng để chạy publisher (mặc định: python trong PATH).
STOCK_LOOKUP_PYTHON=
